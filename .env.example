# CivicMind AI — Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_USER=civicmind
POSTGRES_PASSWORD=civicmind_secret
POSTGRES_DB=civicmind
DATABASE_URL=postgresql+asyncpg://civicmind:civicmind_secret@localhost:5432/civicmind

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=true
DEMO_MODE=true

# Model paths
MODELS_DIR=./models
MURIL_MODEL_NAME=google/muril-base-cased
MURIL_LOCAL_PATH=./models/muril-base-cased

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo map center (Chennai)
DEMO_MAP_LAT=13.0827
DEMO_MAP_LNG=80.2707
